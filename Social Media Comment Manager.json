    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "def extract_field(text, field_name):\n    marker = '\"' + field_name + '\"'\n    idx = text.find(marker)\n    if idx == -1:\n        return None\n    idx = text.find(\":\", idx) + 1\n    while text[idx] in \" \\n\\t\":\n        idx += 1\n    if text[idx] == '\"':\n        idx += 1\n        end = idx\n        while text[end] != '\"' or text[end - 1] == \"\\\\\":\n            end += 1\n        return text[idx:end].replace('\\\\\"', '\"').replace(\"\\\\n\", \"\\n\")\n    else:\n        end = idx\n        while text[end] not in \",}\\n\":\n            end += 1\n        value = text[idx:end].strip()\n        if value == \"true\":\n            return True\n        if value == \"false\":\n            return False\n        if value == \"null\":\n            return None\n        return value\n\nfor item in _items:\n    raw_text = item[\"json\"][\"content\"][\"parts\"][0][\"text\"]\n\n    category = extract_field(raw_text, \"category\")\n    suggested_reply = extract_field(raw_text, \"suggested_reply\")\n    needs_review = extract_field(raw_text, \"needs_human_review\")\n\n    if category is None:\n        category = \"Needs Review\"\n        needs_review = True\n\n    item[\"json\"][\"category\"] = category\n    item[\"json\"][\"suggested_reply\"] = suggested_reply\n    item[\"json\"][\"needs_human_review\"] = needs_review\n\nreturn _items"
      },
